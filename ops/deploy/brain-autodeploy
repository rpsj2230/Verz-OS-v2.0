#!/usr/bin/env bash
# Deploy when a new image is published, without anything on the internet being able to
# reach this machine.
#
# WHY THE SERVER PULLS INSTEAD OF GITHUB PUSHING. Coolify's API is on :8000 and ufw allows
# only 22, 80 and 443 inbound. Letting GitHub Actions call it means allowlisting GitHub's
# Actions ranges: thousands of CIDRs, changed without notice, and any GitHub account can run
# a job from them. That exposes the panel controlling every container here, including the
# database, to a large slice of the internet, in order to save a minute of latency.
#
# THE CI GATE IS PRESERVED, WHICH IS THE PART WORTH CHECKING. This watches the `:latest`
# tag, and `:latest` is only moved by the Deploy workflow, which runs on `workflow_run`
# after CI succeeds. So the tag moving *is* the statement that the gate passed. Watching a
# branch or a commit instead would deploy code that never passed anything.
#
# HOW "IS THERE ANYTHING NEW" IS ANSWERED, AND THE BUG THAT TAUGHT IT. The first version
# read the registry manifest and compared its digest to the local one. It redeployed on
# every single tick: twelve restarts in twenty-five minutes, each one a healthy deploy of
# the image that was already running. `docker manifest inspect --verbose` emits several
# objects each carrying a `digest` field, and taking the first one with `grep -m1` returned
# a digest that is not the image's repo digest, so the comparison could never match.
#
# The fix is not a better parser. It is to stop parsing: pull first, then compare the image
# id the *tag* now points at against the image id the *container* is running. Both come from
# `docker inspect` in the same format, so there is no encoding to get wrong, and a pull when
# nothing has changed is a cheap conditional request rather than a download. The lesson is
# narrow and worth keeping: a comparison between two values produced by different commands
# is a comparison that needs proving equal in the working case, and I never proved it.
set -euo pipefail

IMAGE="ghcr.io/rpsj2230/verz-brain-v2.0:latest"

# The container name is one deployment's and is read rather than written, for the reason
# spelled out in brain-deploy: an identifier from another install makes `docker inspect`
# print nothing, and the comparison below reads an empty `running` as "the container is
# gone, deploy it". So a missing file refuses here rather than deploying on a guess. The
# image above keeps its literal because it is the product's own coordinate: every install
# pulls that same published image.
UUID_FILE="/root/.coolify-service-uuid"
if [ ! -s "$UUID_FILE" ]; then
  echo "$UUID_FILE is missing or empty: write this deployment's Coolify service" >&2
  echo "identifier into it (it is the last path segment of that resource's URL)." >&2
  exit 1
fi
CONTAINER="app-$(cat "$UUID_FILE")"

HEARTBEAT="/var/lib/brain-deploy/heartbeat.json"
mkdir -p "$(dirname "$HEARTBEAT")"

note() {
  printf '{"checked_at":"%s","action":"%s","detail":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" > "$HEARTBEAT"
}

# Bring the tag up to date. Cheap when nothing has moved: the registry answers with a 304
# and no layer is transferred.
if ! docker pull -q "$IMAGE" >/dev/null 2>&1; then
  note "error" "could not reach the registry"
  echo "could not pull $IMAGE" >&2
  exit 1
fi

tag_id=$(docker image inspect "$IMAGE" --format '{{.Id}}' 2>/dev/null || true)
running=$(docker inspect "$CONTAINER" --format '{{.Image}}' 2>/dev/null || true)

if [ -z "$tag_id" ]; then
  note "error" "the tag resolves to no local image"
  echo "no local image for $IMAGE after a successful pull" >&2
  exit 1
fi

# Both sides are an image id from `docker inspect`, so they are the same kind of value in
# the same format. An empty `running` means the container is gone, which is a deploy.
if [ -n "$running" ] && [ "$running" = "$tag_id" ]; then
  note "up-to-date" "$tag_id"
  exit 0
fi

note "deploying" "$tag_id"
/usr/local/bin/brain-deploy
note "deployed" "$tag_id"

# THE POST-DEPLOY CHECKS (M38.5.1), run inside the container just deployed. `brain-deploy`
# returns as soon as Coolify accepts the deploy, before the new container exists, so this waits
# for the container to run the new image and report healthy first. The verdict is written in the
# container and served at /api/deploy-checks.json, where the Deploy workflow reads it; what a
# check found goes to this unit's journal only. See brain.ops.post_deploy.
for _ in $(seq 1 36); do
  running=$(docker inspect "$CONTAINER" --format '{{.Image}}' 2>/dev/null || true)
  health=$(docker inspect "$CONTAINER" --format '{{.State.Health.Status}}' 2>/dev/null || true)
  [ "$running" = "$tag_id" ] && [ "$health" = "healthy" ] && break
  sleep 10
done
if [ "$running" != "$tag_id" ] || [ "$health" != "healthy" ]; then
  note "checks-not-run" "$tag_id"
  echo "the new container was not healthy after six minutes; post-deploy checks not run" >&2
  exit 1
fi
if docker exec "$CONTAINER" python -m brain.ops.post_deploy; then
  note "checks-passed" "$tag_id"
else
  note "checks-failed" "$tag_id"
  echo "post-deploy checks failed; the Deploy workflow will refuse this commit" >&2
  exit 1
fi
