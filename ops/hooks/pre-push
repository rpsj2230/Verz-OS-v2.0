#!/bin/sh
# Runs the same gates CI runs, before anything leaves the laptop.
#
# This is not a substitute for server-side branch protection — a hook can be skipped with
# --no-verify, and on a private repo without GitHub Pro there is no server-side rule to
# fall back on. It is here so the common case (someone pushes broken work by accident)
# is caught in seconds rather than in a CI queue.
#
# Install: git config core.hooksPath ops/hooks
# Task ids: M0.1.3, M38.1.3

set -e

# Git hooks inherit the environment of whatever shell git was invoked from, which on
# Windows is often not the one where uv was added to PATH. Resolve it explicitly rather
# than assuming, or the hook fails for a reason that has nothing to do with the code.
if command -v uv >/dev/null 2>&1; then
  UV=uv
else
  for candidate in \
    "$LOCALAPPDATA/Microsoft/WinGet/Links/uv.exe" \
    "$LOCALAPPDATA/Microsoft/WinGet/Packages/astral-sh.uv_Microsoft.Winget.Source_8wekyb3d8bbwe/uv.exe" \
    "$HOME/.local/bin/uv" \
    "$HOME/.cargo/bin/uv"
  do
    if [ -x "$candidate" ]; then UV="$candidate"; break; fi
  done
fi

if [ -z "$UV" ]; then
  echo "pre-push: cannot find uv." >&2
  echo "  Install it, or push with --no-verify and rely on CI." >&2
  exit 1
fi

# The interpreter is named rather than left to uv's resolution, for the worktree below.
#
# Measured on 2026-09-11. That worktree is a fresh checkout with no environment in it, so uv
# went looking for one of its own and chose a managed CPython in its cache, which is unsigned,
# which Windows Application Control refused: `os error 4551`. The push failed with no gate
# having an opinion, which is the failure mode the comment further down is already about,
# arriving one layer further out.
#
# This repository's own `.venv` is built from a signed interpreter, so its base is a signed
# interpreter, and naming it means the worktree's environment is built from the same one this
# machine already runs. `brain.ops.mutation` carries the same fix for the same reason.
PYBASE="$("$UV" run python -c "import sys; print(sys.base_prefix)" 2>/dev/null || echo "")"
if [ -n "$PYBASE" ] && [ -x "$PYBASE/python.exe" ]; then
  NAMED_PYTHON="--python=$PYBASE/python.exe"
elif [ -n "$PYBASE" ] && [ -x "$PYBASE/bin/python3" ]; then
  NAMED_PYTHON="--python=$PYBASE/bin/python3"
else
  NAMED_PYTHON=""
fi

# Every gate below reads the working tree. That is the right thing to check most of the
# time and it is not what is being pushed, and the difference has now shipped four broken
# commits: a fixed file left unstaged passes every check here and fails in CI, because CI
# reads the commit. So the tree being pushed is checked first, in a throwaway worktree at
# HEAD, and only the cheap structural checks run there: the full suite would double every
# push, and what these four failures had in common was a missing file rather than a subtle
# behaviour, which mypy and the sweeps catch in seconds.
#
# Skipped rather than failed if the worktree cannot be made, because a hook that blocks a
# push for want of disk space is a hook people pass --no-verify to.
# The platform every gate here type checks against. See the note above the types step.
SHIPS_ON=linux

echo "pre-push: the commit, not the working tree"
HEADCHECK="$(mktemp -d 2>/dev/null || echo "")"
if [ -n "$HEADCHECK" ] && git worktree add --detach --quiet "$HEADCHECK" HEAD 2>/dev/null; then
  ( cd "$HEADCHECK" && "$UV" run $NAMED_PYTHON python -m mypy --platform "$SHIPS_ON" && "$UV" run $NAMED_PYTHON python -m brain.ops.sweeps traceability )     || { git worktree remove --force "$HEADCHECK" 2>/dev/null; exit 1; }
  git worktree remove --force "$HEADCHECK" 2>/dev/null
else
  echo "  skipped: could not create a worktree at HEAD"
fi

echo "pre-push: format"
"$UV" run python -m ruff format --check src tests

echo "pre-push: lint"
"$UV" run python -m ruff check src tests

# `--platform "$SHIPS_ON"` rather than this machine's, and it is not a refinement.
#
# On 2026-09-11 a push left CI red on `Statement is unreachable` in a function branching on
# `sys.platform`, and mypy had said Success here moments earlier. mypy narrows that value to
# the platform it is itself running on, so a Windows developer and an ubuntu runner type
# check different halves of such a function and each is silent about the other. CI gates
# Deploy, so the cost was production sitting on the previous commit with nothing saying why.
#
# Linux is the only platform this ships on, so it is the one the gate should be about. The
# native run is still available as `uv run python -m mypy` for anybody debugging a developer
# machine, and `tests/unit/test_ci_workflow.py` holds this flag against the runner ci.yml
# declares, so the two cannot drift apart.
echo "pre-push: types (strict, as the runner sees them)"
"$UV" run python -m mypy --platform "$SHIPS_ON"

echo "pre-push: invariants"
# These encode rules that must never break. If one fails, the push stops here.
"$UV" run python -m pytest tests/invariants -q

# `run python -m <tool>` rather than `run <tool>`, everywhere above.
#
# Measured on 2026-09-07. `uv run mypy` spawns the console shim uv has just written into a
# worktree's brand-new `.venv`, and Windows Application Control refuses a freshly created
# unsigned executable in a temporary directory: `Failed to spawn: mypy ... (os error 4551)`.
# It is intermittent, and it presents as a push that fails with no gate having an opinion,
# which is the worst way for a gate to fail. Running the interpreter uv already trusts and
# importing the tool as a module spawns nothing new. `brain.ops.mutation` carries the same
# fix and the same argument.

echo "pre-push: sweeps"
"$UV" run python -m brain.ops.sweeps tool_registry
"$UV" run python -m brain.ops.sweeps traceability

echo "pre-push: all gates green"
