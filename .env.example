# Every variable the application reads, with what it is for.
# Copy to .env for local work. .env is gitignored and must stay that way.
# Task ids: M0.4.3

# --- identity of this deployment ------------------------------------------
# development | staging | production. Production turns off the interactive API
# docs, because the schema names every tool and capability in the system.
BRAIN_ENV=development

# Set by the pipeline from the git SHA. Shown on /health/ready and the status
# page, so "what is actually running" is answerable without guessing.
BRAIN_COMMIT_SHA=unknown

# --- data -----------------------------------------------------------------
# A bare postgresql:// is accepted and pointed at psycopg 3 automatically.
#
# There is deliberately no password in this URL. It said `change-me` until
# 2026-09-07, and a file people copy is exactly where a default password lives:
# the copy connects, nothing fails, and the value nobody changed is the one the
# install runs with. Put the password in PGPASSWORD or in ~/.pgpass, or write it
# into this line in your own .env, which is gitignored. Without one libpq refuses
# to connect, which is the failure you want rather than a working default.
# brain.firstrun.credential_default_gaps refuses this line if a value comes back.
DATABASE_URL=postgresql://brain@localhost:5432/brain

# Optional here. Absent means the cache is skipped, not that the app fails.
VALKEY_URL=redis://localhost:6379/0

# Set at deploy time. Used once, by the first migration, to give the
# application role a password. Never the same as the postgres superuser.
APP_ROLE_PASSWORD=

# --- behaviour ------------------------------------------------------------
# Migrations run during startup under an advisory lock, before readiness
# passes. Set false only if you apply them by hand with `alembic upgrade head`.
BRAIN_RUN_MIGRATIONS=true

# The console and the widget only. Empty means no cross-origin access at all,
# which is the safe default; there is no wildcard in any environment.
BRAIN_CORS_ORIGINS=

# Distinct from the model timeout. This bounds the whole request.
BRAIN_REQUEST_TIMEOUT_SECONDS=30

# --- tools ----------------------------------------------------------------
# Which system the built-in row tools read from. It becomes the first half of
# every tool name in the catalogue, so "local" gives local.read_price_list.
#
# It is part of the tool's identity and not a label: a row tool is pinned to
# one source as well as one entity, because two systems' record ids collide by
# coincidence of integers and a tool pinned only to the entity reads both.
BRAIN_TOOL_SOURCE=local

# --- profile --------------------------------------------------------------
# lite | standard | full. Which set of wave-2 components this install runs;
# see src/brain/ops/wiring.py for the memory each one costs.
#
#   lite      the application, pooler, database and cache. Nothing else.
#             Records to the audit ledger and ships no traces. This is what
#             is deployed today.
#   standard  adds the worker, the object store, the identity provider, the
#             PII analyser and the inference server. Over the host's budget
#             today; see docs/needs-rupash.md items 25 and 31.
#   full      adds the trace ledger, which needs about 2.3 GiB more and does
#             not fit on the current host. See docs/needs-rupash.md item 25.
#
# Defaults to lite when unset, deliberately: forgetting this variable should
# leave an install under-featured, not running a trace stack nobody sized.
BRAIN_PROFILE=lite

# Where spans go. Leave empty on a lite install: startup refuses a trace
# destination on a profile that runs no trace ledger, because the client
# library would otherwise post spans at a host that either drops them
# silently or belongs to somebody else and keeps them.
BRAIN_LANGFUSE_HOST=
BRAIN_LANGFUSE_PUBLIC_KEY=
BRAIN_LANGFUSE_SECRET_KEY=

# Where text goes to have a model read it. Leave empty on a lite install:
# startup refuses this on a profile that deploys no inference server, and the
# reason is heavier than the one above. A trace host receives metadata about a
# request; this address receives the text of the document itself, so a value
# copied out of another install's environment file sends a client's own
# documents to a host nobody here chose.
BRAIN_INFERENCE_URL=

# --- first run ------------------------------------------------------------
# Blank here, and they have to stay blank. The installer mints both on the
# client's own server, under umask 077, in one step guarded so that a second run
# writes neither, and prints the code once to the person standing there. A setup
# code that arrived with the template would be the same code on every install
# that copied this file, which is worse than having none at all. See
# brain.deployment.variables.A_VALUE_THAT_ARRIVED_WITH_THE_TEMPLATE_WAS_NEVER_MINTED.
BRAIN_SETUP_SECRET=

# When the code above was minted, spelled 2026-01-06T09:00:00Z. The other half of
# the same value: brain.firstrun.derived_enrolment reads the pair and produces the
# window in which the first administrator can be created, so an instant shipped in
# a template would date that window to whenever the release was cut rather than to
# this install. Both blank means the wizard has no code to accept, which is what a
# development machine should be. One of the two blank is refused rather than
# guessed, and the answer there is to reinstall rather than to type a date: a date
# typed now opens a window nobody minted.
BRAIN_SETUP_ISSUED_AT=

# --- deploy (used by ops/deploy.sh, not by the app) -----------------------
# Blank here, and they have to stay blank. This file is copied to /opt/brain/.env
# on the client's own server by step 6 of brain.deployment.installer.PLAN, so a
# value written here is a value that arrives on somebody else's machine. All three
# named one deployment's server until 2026-09-09 - its ssh host, its Coolify
# service identifier and its address - and the independence sweep could not see
# them, because it read src, migrations, the console and docs and this file is
# none of those. It reads this file now.
#
# Nothing defaults them either: ops/deploy.sh refuses to run without them rather
# than falling back, because a deploy script that guesses a host is a deploy
# script that can reach the wrong one. See ops/DEPLOY.md for where each value
# comes from.
#
#   DEPLOY_HOST   the ssh destination, as it is spelled in ~/.ssh/config
#   DEPLOY_UUID   the Coolify service identifier, from that resource's URL
#   DEPLOY_URL    the address the deployed system answers on, with its scheme
DEPLOY_HOST=
DEPLOY_UUID=
DEPLOY_URL=

# Everything below belongs to the installation rather than to the product, and this
# block is generated from `brain.install.INSTALLATION` rather than kept by hand: a
# hand-kept list is wrong the first time somebody adds a setting, and it is wrong by
# omitting the new one, which is the direction nobody notices.
#
# `tests/unit/test_independence.py` compares this against the declaration, so editing a
# value here is expected and editing a name or a meaning fails.
# Task ids: M41.3.1, M41.3.4
# --- this installation ----------------------------------------------------
# branding:
# The client's own name, as it should appear to their staff on every screen.
INSTALL_COMPANY_NAME=Your Company
# What the client calls this system internally. Separate from the company name because several clients rename it, and the page title is the two together.
INSTALL_PRODUCT_NAME=Brain
# An absolute URL to the client's logo, served from somewhere they control.
INSTALL_LOGO_URL=/static/logo.svg
# One hex colour the console's accents are derived from.
INSTALL_ACCENT_COLOUR=#2563eb
# The address notifications come from. It has to be on a domain the client can make us a sender for, or every message they send is a deliverability problem.
INSTALL_SENDER_ADDRESS=no-reply@localhost

# identity:
# The issuer URL of the client's Keycloak realm. No default: see A_GUESSED_IDENTITY_PROVIDER_IS_WORSE_THAN_A_STOPPED_ONE.
# No default. The system refuses to start without it.
INSTALL_OIDC_ISSUER=
# The realm name inside that Keycloak. Part of the issuer, and asked for separately because the setup script needs it before the issuer exists.
INSTALL_OIDC_REALM=brain
# The client id the console authenticates as. Registered in the realm above.
INSTALL_OIDC_CLIENT_ID=brain-console
# Comma-separated redirect URIs the realm will accept. Wrong here is a sign-in that completes and then bounces to a page the client does not own.
# No default. The system refuses to start without it.
INSTALL_OIDC_REDIRECT_URIS=
# Which directory Keycloak brokers sign-in to: google, microsoft, lark, ldap or none. `none` means the realm holds the passwords itself.
INSTALL_BROKERED_DIRECTORY=none
# Where this company keeps the list of who works here: spreadsheet, google_sheet, google_workspace, microsoft_entra, lark, ldap, or none. A separate question from the brokered directory above, because a roster is a list read on a schedule and a sign-in source is a live protocol, and a spreadsheet can only be the first. The default is none, meaning no list is read and people are created in the console: there is no default source because a default would make whichever company was set up first the shape every later one inherits.
INSTALL_STAFF_SOURCE=none
# Where that staff list is: the sheet's identifier, the directory tenant, or the directory address including the base a search starts from. `unset` is the value meaning nobody has said, so a source that was chosen and pointed nowhere refuses rather than reading a company with nobody in it.
INSTALL_STAFF_SOURCE_LOCATION=unset

# models:
# Which models this install may reach: `local` for the inference server alone, `hosted` to allow an external provider. `local` is the default because a client who has not chosen to send text off their own hardware has not chosen it.
INSTALL_MODEL_PROFILE=local
# Where the inference server answers. Inside the client's own network by default.
INSTALL_MODEL_ENDPOINT=http://inference-server:8080
# How many numbers the embedding model returns per passage, which is the width of the column the corpus is stored in. It has to be what the model this install serves actually produces: the width is part of the column's type, so PostgreSQL refuses a vector of any other size rather than storing something meaningless. The default is what the model this product serves by default produces. Set it before the first document is ingested and then leave it alone: changing it afterwards is a re-embed of everything, and the migration refuses to change it while a single chunk is embedded.
INSTALL_EMBEDDING_DIMENSIONS=1024

# storage:
# The S3-compatible endpoint holding assets, recordings and exports. The client's own SeaweedFS, or their S3 or R2 if they would rather.
INSTALL_OBJECT_STORE_URL=http://seaweedfs:8333
# The bucket or path prefix under that endpoint. Separate from the URL so two installs can share an endpoint without sharing a namespace.
INSTALL_OBJECT_STORE_PREFIX=brain
# Where embeddings live. `postgres` means the pgvector column in the client's own database, which is the only option built today and is named so the second one is a value rather than a migration.
INSTALL_VECTOR_STORE=postgres

# locale:
# Comma-separated language tags this install offers, most preferred first. The first is what somebody with no stated preference reads. Only tags this product ships a complete catalogue for are accepted: see brain.locale.SHIPPED.
INSTALL_LOCALES=en,zh-Hans
# The ISO 4217 code money figures are rendered in. XXX is the code meaning no currency, so an install that has not chosen one shows something visibly unset rather than a figure that reads correctly in the wrong currency.
INSTALL_CURRENCY=XXX
# The IANA zone a timestamp is rendered in for a reader with no zone of their own. UTC by default because it is nobody's local time, so a wrong rendering is visibly wrong rather than out by an hour on some days of the year.
INSTALL_TIME_ZONE=UTC

# --- end of this installation ---------------------------------------------
