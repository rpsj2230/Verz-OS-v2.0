{
  "name": "brain-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Company Brain console. Renders answers the gate has already decided. See README.md for why every version below is exact.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "api:schema": "uv run python scripts/export-openapi.py",
    "api:types": "openapi-typescript src/api/generated/openapi.internal.json --output src/api/generated/schema.ts",
    "api:generate": "npm run api:schema && npm run api:types"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "@hookform/resolvers": "5.9.1",
    "@rjsf/core": "6.8.0",
    "@rjsf/utils": "6.8.0",
    "@rjsf/validator-ajv8": "6.8.0",
    "@tanstack/react-table": "9.2.4",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.88.0",
    "react-router-dom": "6.30.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
